# ---------------------------------------------------------------------------
# Browser (public) — Supabase project credentials (Project Settings > API).
# Leave empty to run the public site in local demo mode (no ERP).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public site URL, used for canonical URLs and Open Graph tags
VITE_SITE_URL=https://www.example.com
# Address that receives quote requests and contact messages by e-mail (FormSubmit)
VITE_NOTIFY_EMAIL=ultrasupply.tn@gmail.com

# ---------------------------------------------------------------------------
# Server only (Vercel → Settings → Environment Variables). NEVER prefix with VITE_.
# Used by /api/admin-users (staff accounts) — keep secret.
SUPABASE_SERVICE_ROLE_KEY=
# E-mail delivery of quotations / invoices / receipts (https://resend.com).
# Without these, "Envoyer par e-mail" falls back to downloading the PDF + opening the mail client.
RESEND_API_KEY=
MAIL_FROM="ULTRA SUPPLY <factures@votre-domaine.tn>"
MAIL_REPLY_TO=ultrasupply.tn@gmail.com
